# NetVera production hardening
Options -Indexes
<FilesMatch "^(\.env\.php|database\.sql|docker-compose\.yml|README(?:\.md|\.txt)?)$">
  Require all denied
</FilesMatch>

RewriteEngine On
RewriteRule ^(?:app|config|partials|tests|\.github|\.devcontainer)(?:/|$) - [F,L]

DirectoryIndex index.php index.html

# Dynamic SEO endpoints must win before physical demo files.
RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]
RewriteRule ^robots\.txt$ robots.php [L,QSA]
RewriteRule ^([A-Fa-f0-9-]{8,128})\.txt$ indexnow-key.php?key=$1 [L,QSA]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^hakkimizda/?$ hakkimizda.php [L,QSA]
RewriteRule ^hizmetler/?$ hizmetler.php [L,QSA]
RewriteRule ^hizmet/([a-z0-9-]+)/?$ hizmet.php?slug=$1 [L,QSA]
RewriteRule ^projeler/?$ projeler.php [L,QSA]
RewriteRule ^proje/([a-z0-9-]+)/?$ proje.php?slug=$1 [L,QSA]
RewriteRule ^blog/?$ blog.php [L,QSA]
RewriteRule ^blog/([a-z0-9-]+)/?$ yazi.php?slug=$1 [L,QSA]
RewriteRule ^bolgeler/?$ bolgeler.php [L,QSA]
RewriteRule ^bolge/([a-z0-9-]+)/?$ bolge.php?slug=$1 [L,QSA]
RewriteRule ^iletisim/?$ iletisim.php [L,QSA]
RewriteRule ^kvkk-aydinlatma-metni/?$ sayfa.php?slug=kvkk-aydinlatma-metni [L,QSA]
RewriteRule ^gizlilik-politikasi/?$ sayfa.php?slug=gizlilik-politikasi [L,QSA]
RewriteRule ^cerez-politikasi/?$ sayfa.php?slug=cerez-politikasi [L,QSA]

# Admin panelindeki Sayfalar / Landing kayıtlarını kök URL'den yayınlar.
RewriteRule ^([a-z0-9-]+)/?$ sayfa.php?slug=$1 [L,QSA]
